# Copy to `.env` and fill in. `.env` is git-ignored — never commit secrets.

# --- provider: auto | openai | gemini ---------------------------------------
# auto = use OPENAI_API_KEY if present, else GEMINI_API_KEY, else run offline.
LLM_PROVIDER=auto

# --- credentials (required for live LLM branches) ---------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- models (defaults depend on the active provider) ------------------------
# openai defaults: gpt-4o-mini | gemini defaults: gemini-2.5-flash
ROUTE_MODEL=
GENERAL_MODEL=
MATH_MODEL=
MODEL_TEMPERATURE=0

# Optional override of the Google Generative Language API root (proxy/mock).
# e.g. http://127.0.0.1:8200 for scripts/mock_gemini.py
GOOGLE_BASE_URL=

# --- tunables ---------------------------------------------------------------
ROUTER_TIMEOUT_S=2.5
STREAM_STALL_TIMEOUT_S=30
MAX_QUERY_CHARS=4000
LOG_LEVEL=INFO

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
WORKERS=1
